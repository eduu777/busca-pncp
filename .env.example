# ============================================================================
# 1. BANCO DE DADOS POSTGRESQL
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui
DB_NAME=pncp_dados
DB_POOL_MAX=10

# ============================================================================
# 2. SELEÇÃO DO PROVEDOR DE IA
# Opções disponíveis para AI_PROVIDER:
#   - GROQ     (Usa GROQ_API_KEY - Ultra rápido)
#   - GROK     (Usa GROK_API_KEY da xAI ou fallback para GROQ_API_KEY)
#   - GEMINI   (Usa GEMINI_API_KEY do Google AI Studio)
#   - CHATGPT  (Usa OPENAI_API_KEY da OpenAI)
#   - CLAUDE   (Usa CLAUDE_API_KEY da Anthropic)
# ============================================================================
AI_PROVIDER=GROQ

# Chaves de API (preencha a chave do provedor escolhido acima)
GROQ_API_KEY=gsk_sua_chave_groq_aqui
GROK_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=

# Modelos opcionais (se deixados em branco, usa o modelo padrão recomendado de cada provedor)
GROQ_MODEL=openai/gpt-oss-120b
GROK_MODEL=grok-3-mini
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini
CLAUDE_MODEL=claude-3-5-sonnet-latest

# ============================================================================
# 3. FILTROS DO PNCP E REGRAS DE PROSPECÇÃO
# ============================================================================
# Estado (UF) e Cidade (Use "Fortaleza" ou "TODAS" para todas as cidades do estado)
PNCP_UF=CE
PNCP_MUNICIPIO=Fortaleza
PNCP_MODALIDADE=6

# Opcional: Fixar intervalo de datas específico no formato YYYYMMDD (se omitido, busca D-1 até D)
# PNCP_DATA_INICIAL=20261103
# PNCP_DATA_FINAL=20261104

# Score mínimo (1 a 10) para aprovar o edital e salvar PDF + Dossiê na pasta de prospecção
SCORE_MINIMO_DOWNLOAD=7

# Agendamento Cron (Padrão: às 06:00 e às 18:00)
CRON_SCHEDULE=0 6,18 * * *
CRON_TIMEZONE=America/Fortaleza

